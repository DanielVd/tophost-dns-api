# Required Tophost account credentials
TOPHOST_USER=user@example.com
TOPHOST_PASS=change-me

# Authentication protecting the local REST API
TOPHOST_API_KEY=change-me

# Optional convenience only.
# If omitted, API clients must explicitly select a discovered domain.
# TOPHOST_DEFAULT_DOMAIN=example.com

# Persistent runtime state.
# Must live outside the Git repository.
TOPHOST_STATE_DIR=/var/lib/tophost-dns-api

# Optional upstream HTTP timeout, in seconds.
# TOPHOST_REQUEST_TIMEOUT=20
